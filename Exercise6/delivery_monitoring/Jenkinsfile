// Declarative pipeline for the delivery monitoring stack.
// The agent needs Docker with the Compose v2 plugin, plus curl and grep.
pipeline {
    agent any

    options {
        timeout(time: 10, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Validate') {
            steps {
                dir('Exercise6/delivery_monitoring') {
                    sh 'docker compose config -q'
                }
            }
        }

        stage('Build') {
            steps {
                dir('Exercise6/delivery_monitoring') {
                    sh 'docker compose build'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('Exercise6/delivery_monitoring') {
                    sh 'docker compose up -d'
                }
            }
        }

        stage('Smoke test') {
            steps {
                dir('Exercise6/delivery_monitoring') {
                    // The simulator needs a moment before the first scrape is useful.
                    sh '''
                        set -eu
                        for attempt in $(seq 1 15); do
                            if curl -fsS http://localhost:8000/metrics -o /tmp/delivery-metrics.txt; then
                                break
                            fi
                            echo "waiting for /metrics, attempt ${attempt}"
                            sleep 2
                        done
                        if ! grep -q "^pending_deliveries" /tmp/delivery-metrics.txt; then
                            echo "pending_deliveries is missing from /metrics" >&2
                            exit 1
                        fi
                        echo "smoke test passed"
                    '''
                }
            }
        }
    }

    post {
        always {
            dir('Exercise6/delivery_monitoring') {
                sh 'docker compose ps'
            }
        }
        failure {
            dir('Exercise6/delivery_monitoring') {
                sh 'docker compose logs --tail 100'
            }
        }
    }
}
